{
  "name": "wexample/symfony-remote-wikimedia",
  "description": "Wikimedia Commons as a symfony-remote: what a file is — its address, a thumbnail, its author and license — and its download",
  "version": "1.0.1",
  "type": "library",
  "license": "MIT",
  "autoload": {
    "psr-4": {
      "Wexample\\SymfonyRemoteWikimedia\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Wexample\\SymfonyRemoteWikimedia\\Tests\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "weeger",
      "email": "romain.weeger@wexample.com"
    }
  ],
  "require": {
    "php": ">=8.5",
    "wexample/symfony-helpers": ">=19.3.0",
    "wexample/symfony-remote": ">=2.2.0",
    "wexample/php-remote": ">=3.0.0",
    "symfony/http-client": ">=7.0",
    "symfony/filesystem": ">=7.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^13"
  },
  "repositories": [
    {
      "type": "path",
      "url": "../*",
      "options": {
        "symlink": true
      }
    }
  ],
  "extra": {
    "install": {
      "bundle_env": "all"
    }
  }
}
